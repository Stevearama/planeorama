# OpenSky Network — OAuth2 client credentials
# Create these at: https://opensky-network.org/my-opensky (API Clients section)
OPENSKY_CLIENT_ID=your_client_id_here
OPENSKY_CLIENT_SECRET=your_client_secret_here

# Google Drive — service account JSON key (paste the entire JSON on one line)
# See SETUP.md for how to create this.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Drive — ID of the folder where CSVs will be saved
# Get this from the URL when you open the folder: drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
